  color: #ffffff;
  font-size: 14px;
  font-weight: 700;
  cursor: pointer;
  font-family: inherit;
  outline: none;
  box-shadow: 0 2px 8px rgba(37,99,235,0.35);
  transition: background 0.15s, transform 0.1s;
}

.cs-footer-confirm:hover    { background: #1D4ED8; }
.cs-footer-confirm:active   { transform: scale(0.97); }
.cs-footer-confirm:disabled { background: #93C5FD; cursor: not-allowed; box-shadow: none; }

@media (min-width: 640px) {
  .cs-scroll  { padding: 24px 24px 100px; max-width: 560px; margin: 0 auto; }
  .cs-footer  { padding: 14px 24px; }
  .cs-header  { padding: 28px 24px 20px; }
}
</file>

