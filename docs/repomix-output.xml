  flex: 1;
  min-width: 0;
}

.product-name {
  font-size: 16px;
  font-weight: 700;
  color: #111827;
  margin: 0 0 5px 0;
  line-height: 1.35;
  letter-spacing: -0.1px;
}

.product-description {
  font-size: 13px;
  color: #6B7280;
  margin: 0 0 10px 0;
  line-height: 1.55;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ============================================
   Metadata Row
   ============================================ */
.product-meta-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6px;
  margin-top: 2px;
}

.product-meta-badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  background: #F4F6F9;
  border-radius: 6px;
  padding: 3px 8px;
}

.meta-label {
  font-size: 10px;
  font-weight: 700;
  color: #9CA3AF;
  text-transform: uppercase;
  letter-spacing: 0.4px;
}

.meta-value {
  font-size: 12px;
  color: #374151;
  font-weight: 600;
}

.meta-value.empty {
  color: #C4C9D4;
  font-style: italic;
  font-weight: 400;
}

/* ============================================
   Action Buttons (Right Side)
   ============================================ */
.product-card-actions {
  display: flex;
  flex-direction: column;
  gap: 8px;
  flex-shrink: 0;
  padding-top: 2px;
}

.product-action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border-radius: 11px;
  border: none;
  cursor: pointer;
  font-size: 17px;
  transition: background 0.15s ease, transform 0.1s ease;
  outline: none;
  -webkit-tap-highlight-color: transparent;
}

.product-action-btn:active {
  transform: scale(0.88);
}

.product-action-btn.edit {
  background: #EFF6FF;
  color: #2563EB;
}

.product-action-btn.edit:hover {
  background: #DBEAFE;
}

.product-action-btn.delete {
  background: #FEF2F2;
  color: #DC2626;
}

.product-action-btn.delete:hover {
  background: #FEE2E2;
}

/* ============================================
   Product Details Row (price / stock / options)
   ============================================ */
.product-details-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6px;
  margin-top: 10px;
  padding-top: 10px;
  border-top: 1px solid #F1F5F9;
}

.product-detail-badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  border-radius: 7px;
  padding: 4px 9px;
}

.product-detail-badge.price {
  background: #F0FDF4;
  color: #059669;
}

.product-detail-badge.stock {
  background: #EFF6FF;
  color: #2563EB;
}

.product-detail-badge.options {
  background: #F5F3FF;
  color: #7C3AED;
}

.product-detail-badge.unit-price {
  background: #FFF7ED;
  color: #D97706;
}

.detail-label {
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.4px;
  opacity: 0.75;
}

.detail-value {
  font-size: 12px;
  font-weight: 700;
}

/* ============================================
   Floating Action Button
   ============================================ */
.products-fab {
  --background: #2563EB;
  --background-activated: #1D4ED8;
  --background-hover: #1D4ED8;
  --box-shadow: 0 4px 18px rgba(37, 99, 235, 0.45);
  --border-radius: 16px;
}

/* ============================================
   Responsive — Tablet & Desktop
   ============================================ */
@media (min-width: 640px) {
  .products-search-section {
    padding: 16px 24px 12px;
  }

  .products-list {
    padding: 16px 24px;
  }

  .products-results-count {
    padding: 12px 24px 0;
  }
}

@media (min-width: 768px) {
  .products-search-section {
    padding: 20px 32px 14px;
    max-width: 860px;
    margin-left: auto;
    margin-right: auto;
  }

  .products-list {
    padding: 20px 32px;
    max-width: 860px;
    margin: 0 auto;
    gap: 14px;
  }

  .products-results-count {
    padding: 14px 32px 0;
    max-width: 860px;
    margin: 0 auto;
  }

  .product-card-body {
    padding: 18px 20px;
  }

  .product-name {
    font-size: 17px;
  }
}
</file>

