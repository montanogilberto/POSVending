                    // Backend example:
                    // { result: [{ value: "4320", msg: "Deleted Successfully", error: "0" }] }
                    const msg = res?.result?.[0]?.msg ?? 'Acción realizada exitosamente';
                    setToastMessage(msg);
                    setShowToast(true);

                    // Reload from backend to reflect deletion/update
                    const incomes = await fetchAllLaundry();
